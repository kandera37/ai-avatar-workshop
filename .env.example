# Default demo uses a deterministic local image fixture.
APP_MODE=demo
PORT=3000
# The launcher creates a private .runtime/admin-code.txt automatically.

# To connect your own provider, explicitly enable both settings.
# APP_MODE=connected
# ALLOW_PAID_IMAGE_API=1
# AI_API_URL=https://api.quanteex.com/v1/images/generations
# AI_API_KEY=YOUR_PROVIDER_KEY
# AI_MODEL=gpt-image-2.5-sunburst
# AI_FALLBACK_MODEL=gpt-image-2.5-flare
# AI_EDIT_MODEL=gpt-image-2.5-flare

# Optional server-to-server API, disabled until a dedicated key is configured.
# QUEST_API_KEY=YOUR_DEDICATED_RANDOM_KEY_AT_LEAST_32_CHARACTERS
# QUEST_PUBLIC_ORIGIN=https://your-own-public-host.example
# Quotas are persisted separately. Change totals in .runtime/budgets/connected.
# Connected mode starts with zero newly configured paid calls.
